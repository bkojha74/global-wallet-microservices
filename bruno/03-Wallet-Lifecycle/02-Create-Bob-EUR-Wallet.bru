meta {
  name: 02 - Create Bob EUR Wallet
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "wallet_id": "{{bobWallet}}",
    "currency": "EUR",
    "owner_id": "bob"
  }
}

assert {
  res.status: in [200, 409]
}
