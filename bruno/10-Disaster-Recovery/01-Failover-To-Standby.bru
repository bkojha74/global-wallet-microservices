meta {
  name: 01 - Failover to Hot Standby (EU)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/cluster/failover
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "target": "STANDBY"
  }
}

assert {
  res.status: eq 200
  res.body.active_target: eq STANDBY
}
