meta {
  name: 06 - List Virtual IBANs
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/wallets/{{aliceWallet}}/vibans
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: eq 200
  res.body.wallet_id: eq {{aliceWallet}}
  res.body.vibans: isDefined
}
