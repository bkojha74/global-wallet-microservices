meta {
  name: 01 - Request Step-Up MFA Challenge
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/step-up/challenge
  body: json
  auth: none
}

body:json {
  {
    "user_id": "alice",
    "action": "transfer"
  }
}

assert {
  res.status: eq 200
  res.body.challenge_id: isDefined
  res.body.nonce: isDefined
  res.body.consumed: eq false
}
