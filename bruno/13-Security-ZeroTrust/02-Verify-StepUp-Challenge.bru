meta {
  name: 02 - Verify Step-Up MFA Challenge Proof
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/step-up/verify
  body: json
  auth: none
}

body:json {
  {
    "challenge_id": "test-challenge-dummy-id",
    "proof": "passkey-biometric-verified"
  }
}

assert {
  res.status: in [200, 401]
}
