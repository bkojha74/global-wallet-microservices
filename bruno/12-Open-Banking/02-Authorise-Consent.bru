meta {
  name: 02 - Authorise Consent
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/open-banking/consents/authorise
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "consent_id": "{{consentId}}",
    "user_id": "alice"
  }
}

assert {
  res.status: eq 200
  res.body.consent_id: isDefined
  res.body.status: eq AUTHORISED
}
