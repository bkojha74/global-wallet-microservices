# ==============================================================================
# Global Multi-Currency Digital Wallet & Ledger Service
# Environment Configuration & Secret Management Template
# ==============================================================================

# General Service Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Security & Authentication (Phase 2: GAP-SEC-01, GAP-SEC-03, GAP-SEC-04)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying HMAC-SHA256 JWT tokens
# IMPORTANT: In production, supply a strong 256-bit cryptographically random key!
JWT_SECRET=production-grade-256bit-secret-key-change-in-production

# ------------------------------------------------------------------------------
# Mutual TLS (mTLS) Inter-Service Communication (Phase 2: GAP-SEC-02)
# ------------------------------------------------------------------------------
# Set to 'true' to require strict mutual TLS for all gRPC connections
GRPC_TLS_ENABLED=false

# Paths to x509 Certificates and Private Keys
GRPC_CA_CERT=./certs/ca.crt
GRPC_SERVER_CERT=./certs/server.crt
GRPC_SERVER_KEY=./certs/server.key
GRPC_CLIENT_CERT=./certs/client.crt
GRPC_CLIENT_KEY=./certs/client.key
GRPC_SERVER_NAME=localhost

# ------------------------------------------------------------------------------
# API Gateway Rate Limiting & Bounds (Phase 2: GAP-SEC-05)
# ------------------------------------------------------------------------------
HTTP_PORT=8080
RATE_LIMIT_RPS=60
RATE_LIMIT_BURST=100

# ------------------------------------------------------------------------------
# Microservices Addresses
# ------------------------------------------------------------------------------
PRIMARY_WALLET_ADDR=127.0.0.1:50051
STANDBY_WALLET_ADDR=127.0.0.1:50053
LEDGER_ADDR=127.0.0.1:50052

# ------------------------------------------------------------------------------
# MongoDB Persistence Layer (Phase 1: GAP-DB-01, GAP-DB-03, GAP-DB-04)
# ------------------------------------------------------------------------------
# Connection string with replica set support for multi-document ACID transactions
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true

# ------------------------------------------------------------------------------
# Asynchronous Logging & Observability (GAP-01 through GAP-10)
# ------------------------------------------------------------------------------
LOGGING_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
LOGGING_SERVICE_PORT=8090
LOGGING_METRICS_PORT=9090
LOGGING_OUTBOX_ENABLED=false
LOGGING_QUEUE_TYPE=classic
LOGGING_RETENTION_DAYS=90
LOGGING_RETENTION_INTERVAL_HOURS=24
