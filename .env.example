# ==============================================================================
# Global Multi-Currency Digital Wallet & Ledger Service
# Environment Configuration & Secret Management Template
# ==============================================================================

# General Service Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Security & Authentication (Phase 2: GAP-SEC-01, GAP-SEC-03, GAP-SEC-04)
# ------------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 JWT signing (HS256 mode — development default).
# IMPORTANT: In production, configure RS256 via AUTH_PRIVATE_KEY_PATH/AUTH_PUBLIC_KEY_PATH instead.
# The JWT_SECRET is now ONLY used by auth-service; the API Gateway no longer holds it.
JWT_SECRET=production-grade-256bit-secret-key-change-in-production

# ------------------------------------------------------------------------------
# Mutual TLS (mTLS) Inter-Service Communication (Phase 2: GAP-SEC-02)
# ------------------------------------------------------------------------------
# Set to 'true' to require strict mutual TLS for all gRPC connections
GRPC_TLS_ENABLED=false

# Paths to x509 Certificates and Private Keys
GRPC_CA_CERT=./certs/ca.crt
GRPC_SERVER_CERT=./certs/server.crt
GRPC_SERVER_KEY=./certs/server.key
GRPC_CLIENT_CERT=./certs/client.crt
GRPC_CLIENT_KEY=./certs/client.key
GRPC_SERVER_NAME=localhost

# ------------------------------------------------------------------------------
# API Gateway Rate Limiting & Bounds (Phase 2: GAP-SEC-05)
# ------------------------------------------------------------------------------
HTTP_PORT=8080
RATE_LIMIT_RPS=60
RATE_LIMIT_BURST=100

# Auth Service Address (resolved by API Gateway to delegate token validation)
AUTH_SERVICE_ADDR=127.0.0.1:50054
AUTH_SERVICE_PORT=50054

# RSA Key Paths for RS256 signing (recommended for production over HS256)
# Generate with: openssl genrsa -out auth_private.pem 2048
#                openssl rsa -in auth_private.pem -pubout -out auth_public.pem
AUTH_PRIVATE_KEY_PATH=./certs/auth_private.pem
AUTH_PUBLIC_KEY_PATH=./certs/auth_public.pem
AUTH_KEY_ID=default

# Default admin credentials seeded on first startup (change immediately in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Gateway claim-cache fingerprint key (used only for HMAC cache-key computation, NOT for JWT signing)
CACHE_FINGERPRINT_SECRET=a-random-stable-string-for-cache-key-hashing

# ------------------------------------------------------------------------------
# Keycloak & External OIDC Identity Provider Integration
# ------------------------------------------------------------------------------
# Provider mode: 'local' (MongoDB only), 'keycloak' (OIDC only), or 'hybrid' (accepts both)
AUTH_PROVIDER=hybrid

# Base URL of Keycloak server (e.g. http://localhost:8080 or http://keycloak:8080)
KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name
KEYCLOAK_REALM=wallet-realm

# Keycloak client ID configured for this application (e.g. wallet-api)
KEYCLOAK_CLIENT_ID=wallet-api

# Keycloak client secret (required only if client is confidential / for backchannel token exchange)
KEYCLOAK_CLIENT_SECRET=

# Optional manual override for Keycloak JWKS certs endpoint (auto-discovered via OIDC if blank)
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/wallet-realm/protocol/openid-connect/certs

# Microservices Addresses
PRIMARY_WALLET_ADDR=127.0.0.1:50051
STANDBY_WALLET_ADDR=127.0.0.1:50053
LEDGER_ADDR=127.0.0.1:50052

# ------------------------------------------------------------------------------
# MongoDB Persistence Layer (Phase 1: GAP-DB-01, GAP-DB-03, GAP-DB-04)
# ------------------------------------------------------------------------------
# Connection string with replica set support for multi-document ACID transactions
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true

# ------------------------------------------------------------------------------
# High Availability & Failover Consensus (Phase 3: GAP-HA-01, GAP-HA-02)
# ------------------------------------------------------------------------------
# Primary active node vs standby hot DR node configuration
REGION_NAME=us-east-1-primary
IS_ACTIVE=true
COORDINATOR_ROLE=PRIMARY

# ------------------------------------------------------------------------------
# Core Service Management & Prometheus Metrics (Phase 3: GAP-OBS-02)
# ------------------------------------------------------------------------------
# Dedicated HTTP server for /metrics and /healthz
# 9094 (wallet-primary), 9093 (wallet-standby), 9092 (ledger-service), 8081 (api-gateway)
METRICS_PORT=9094

# ------------------------------------------------------------------------------
# OpenTelemetry Distributed Tracing (Phase 3: GAP-OBS-01)
# ------------------------------------------------------------------------------
# Optional OTLP gRPC/HTTP collector endpoint (defaults to stdout/no-op)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ------------------------------------------------------------------------------
# Asynchronous Logging & Observability (GAP-01 through GAP-10)
# ------------------------------------------------------------------------------
LOGGING_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
LOGGING_SERVICE_PORT=8090
LOGGING_METRICS_PORT=9090
LOGGING_OUTBOX_ENABLED=false
LOGGING_QUEUE_TYPE=classic
LOGGING_RETENTION_DAYS=90
LOGGING_RETENTION_INTERVAL_HOURS=24

