		{
			"item": [
				{
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test(\"Transfer executed successfully with quote\", function () {",
									"    pm.expect(data.status).to.eql(\"SUCCESS\");",
									"    pm.expect(data.transaction_id).to.be.a('string');",
									"    pm.expect(data.fx_quote_id).to.eql(pm.collectionVariables.get(\"fx_quote_id\") || pm.environment.get(\"fx_quote_id\"));",
									"    pm.expect(data.converted_amount.currency).to.eql(\"EUR\");",
									"    pm.expect(data.converted_amount.units).to.be.above(0);",
									"    pm.expect(data.exchange_rate).to.be.above(0);",
									"});",
									"if (data.transaction_id) {",
									"    pm.environment.set(\"test_txn_id\", data.transaction_id);",
									"    pm.collectionVariables.set(\"test_txn_id\", data.transaction_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"name": "4.1 Cross-Currency Transfer with Locked Quote (Alice USD -\u003e Bob EUR)",
					"request": {
